#!/usr/bin/env bash

set -euo pipefail

die() {
    printf 'codex-sudo: %s\n' "$*" >&2
    exit 2
}

usage() {
    printf '%s\n' \
        'usage: codex-sudo --reason REASON -- COMMAND [ARG ...]' \
        '       codex-sudo --help'
}

reason=
while (($#)); do
    case $1 in
        --reason)
            (($# >= 2)) || die '--reason requires a value'
            reason=$2
            shift 2
            ;;
        --reason=*)
            reason=${1#*=}
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            die "unexpected argument before --: $1"
            ;;
    esac
done

[[ $reason =~ [^[:space:]] ]] || die 'a concrete, nonempty reason is required'
(($#)) || die 'a command is required after --'

if [[ -z ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
    runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$(/usr/bin/id -u)}
    if [[ $runtime_dir == /* && -S $runtime_dir/bus ]]; then
        export XDG_RUNTIME_DIR=$runtime_dir
        export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$runtime_dir/bus}
        while IFS='=' read -r name value; do
            case $name in
                DISPLAY | WAYLAND_DISPLAY | XAUTHORITY)
                    [[ -n ${!name:-} ]] || {
                        printf -v "$name" '%s' "$value"
                        export "$name"
                    }
                    ;;
            esac
        done < <(/usr/bin/systemctl --user show-environment 2>/dev/null || true)
    fi
fi
[[ -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]] || die 'no graphical session is available'

while read -r field value _; do
    if [[ $field == NoNewPrivs: && $value == 1 ]]; then
        die 'the sandbox forbids sudo; rerun this façade with escalated sandbox permission'
    fi
done </proc/self/status

script=$(readlink -f -- "${BASH_SOURCE[0]}")
askpass=${script%/*}/codex-sudo-askpass
[[ -x $askpass ]] || die "askpass helper is not executable: $askpass"

printf -v command_display '%q ' "$@"
export CODEX_SUDO_COMMAND=${command_display% }
export CODEX_SUDO_REASON=$reason
export SUDO_ASKPASS=$askpass

exec /usr/bin/sudo -A -p 'Codex requests administrator authentication.' -- "$@"
